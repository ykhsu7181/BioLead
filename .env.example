# Copy this file to .env for local NCBI configuration.
# Do not commit .env.
# Do not put real secrets in this example file.

NCBI_TOOL=ScholarLeadAgent
NCBI_EMAIL=your.email@example.com
NCBI_API_KEY=

# Optional Crossref polite API configuration.
CROSSREF_BASE_URL=https://api.crossref.org
CROSSREF_USER_AGENT=ScholarLeadAgent/0.1 (set CROSSREF_MAILTO for contact)
CROSSREF_MAILTO=

# Optional NIH RePORTER public API configuration.
NIH_REPORTER_BASE_URL=https://api.reporter.nih.gov
NIH_REPORTER_PROJECTS_SEARCH_URL=https://api.reporter.nih.gov/v2/projects/search
NIH_REPORTER_USER_AGENT=ScholarLeadAgent/0.1 (set NCBI_EMAIL for contact)

# Optional OpenAI-compatible model configuration for later Agent stages.
# Leave empty unless you are running a real model smoke test locally.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_FALLBACK_MODEL=

# Optional model routing / usage logging.
OPENAI_PROVIDER=openai_compatible
OPENAI_ACCOUNT_ALIAS=default
AGENT_DEFAULT_MODEL=
EMAIL_DRAFT_DEFAULT_MODEL=
AI_USAGE_DIR=data/processed/ai_usage
EMAIL_AUDIT_DIR=data/processed/email_audit
DATABASE_PATH=data/processed/scholarlead_agent.sqlite
SENDER_PROFILE_PATH=data/config/sender_profile.json
TOKEN_WARNING_THRESHOLD=
COST_WARNING_THRESHOLD=
AI_PRICING_CONFIG_VERSION=unconfigured
# Optional real email sending configuration for Stage 28.
# Keep EMAIL_SEND_ENABLED=false unless you are running a local manual smoke test.
# Do not put real SMTP passwords or authorization codes in this example file.
EMAIL_PROVIDER=smtp
EMAIL_SEND_ENABLED=false
EMAIL_SENDER=your_sender@example.com
EMAIL_TEST_RECIPIENT=your_test_recipient@example.com
EMAIL_ALLOWED_RECIPIENTS=your_test_recipient@example.com
EMAIL_DAILY_LIMIT=5

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=your_sender@example.com
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_TIMEOUT_SECONDS=30

